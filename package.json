{
  "name": "karu-pdf",
  "private": true,
  "type": "module",
  "license": "AGPL-3.0-or-later",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "e2e": "playwright test --project=e2e",
    "bench": "playwright test --project=bench",
    "make-test-pdf": "node scripts/make-test-pdf.mjs",
    "engine-bench": "node scripts/engine-bench.mjs",
    "build:fixed": "tsc --noEmit && vite build --mode fixed",
    "audit:network": "node scripts/audit-network.mjs",
    "package:fixed": "node scripts/package-fixed.mjs",
    "release:fixed": "npm run audit:network && npm test && npm run build:fixed && npm run audit:network -- --dist && npm run package:fixed",
    "e2e:fixed": "playwright test --project=fixed",
    "build:single": "tsc --noEmit && vite build --mode single && node scripts/assemble-single.mjs",
    "package:single": "node scripts/package-fixed.mjs --single",
    "release:single": "npm run audit:network && npm test && npm run build:single && npm run audit:network -- --single && npm run package:single",
    "e2e:single": "playwright test --project=single"
  },
  "dependencies": {
    "mupdf": "1.28.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@embedpdf/pdfium": "2.15.1",
    "@playwright/test": "^1.63.0",
    "@types/node": "^26.6.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.1",
    "vite-plugin-pwa": "1.3.0",
    "vitest": "^5.0.2"
  }
}
